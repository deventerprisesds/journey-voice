{
  "schemaVersion": 1,
  "appName": "TaskOS",
  "baseUrl": "https://journey-voice.lovable.app",
  "themeColor": "#1e40af",
  "notifications": {
    "channels": [
      {
        "id": "messages",
        "name": "Messages",
        "description": "AI assistant messages, chat responses, and morning briefing",
        "importance": "high",
        "sound": "default",
        "vibrate": true,
        "repeatEnabled": false,
        "repeatIntervalSeconds": 0,
        "repeatMaxTimes": 0,
        "ledColor": "",
        "deepLink": "/"
      },
      {
        "id": "task-reminders",
        "name": "Task Reminders",
        "description": "Overdue and due-soon task alerts — ID uses hyphens to match live edge function. See send-push-notification/index.ts.",
        "importance": "high",
        "sound": "default",
        "vibrate": true,
        "repeatEnabled": false,
        "repeatIntervalSeconds": 0,
        "repeatMaxTimes": 0,
        "ledColor": "",
        "deepLink": "/tasks"
      },
      {
        "id": "calendar_events",
        "name": "Calendar Events",
        "description": "Event start alarms — plays alarm ringtone with Snooze and Dismiss",
        "importance": "alarm",
        "sound": "alarm",
        "vibrate": true,
        "repeatEnabled": false,
        "repeatIntervalSeconds": 0,
        "repeatMaxTimes": 0,
        "ledColor": "",
        "deepLink": "/calendar"
      },
      {
        "id": "agenda",
        "name": "Daily Agenda",
        "description": "Kept for backward compatibility with older APKs — new notifications use 'messages' channel instead",
        "importance": "default",
        "sound": "default",
        "vibrate": false,
        "repeatEnabled": false,
        "repeatIntervalSeconds": 0,
        "repeatMaxTimes": 0,
        "ledColor": "",
        "deepLink": "/"
      }
    ]
  },
  "interactiveWidget": {
    "enabled": true,
    "chatDeepLink": "/tasks",
    "hintText": "Add a task for today..."
  },
  "scheduleWidget": {
    "enabled": true,
    "hintText": "What's next..."
  },
  "prioritiesWidget": {
    "enabled": true,
    "categories": ["CAREER", "VENTURES", "EDUCATION", "LIFE", "FAMILY"]
  },
  "widget": {
    "enabled": true,
    "name": "TaskOS",
    "dataUrl": "https://wwxgajrtmslzklnyplah.supabase.co/external_calendar_events",
    "refreshMinutes": 15,
    "tapDeepLink": "/"
  },
  "deepLinks": {
    "Authentication": "/auth",
    "Debug": "/debug",
    "Tasks": "/tasks",
    "Daily Priorities": "/agenda",
    "Admin Panel": "/admin",
    "Settings": "/settings",
    "Calendar": "/calendar",
    "Priorities": "/priorities",
    "Assignments": "/assignments",
    "Catch All": "/*"
  },
  "auth": {
    "loginPath": "/auth",
    "persistSession": true,
    "trustedAuthDomains": []
  },
  "voice": {
    "enabled": true,
    "floatingButton": true,
    "buttonPosition": "bottom-right",
    "buttonOffsetDp": { "x": 24, "y": 100 },
    "ttsLocale": "en-US",
    "conversationMode": true,
    "silenceTimeoutMs": 1500
  }
}
